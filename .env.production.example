# ──────────────────────────────────────────────────────────────────────────────
# GSF Azalea — Production Environment Variables
#
# Copy this file to .env.production and fill in real values.
#   cp .env.production.example .env.production
# ──────────────────────────────────────────────────────────────────────────────

# ── GitHub Container Registry ─────────────────────────────────────────────
# Your GitHub <owner>/<repo> — used to pull images from ghcr.io
GITHUB_REPOSITORY=rahilsama/gsf-azalea

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=student_tracking

# ── Backend ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://your-ec2-ip:3000

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://your-ec2-ip:4000/api
